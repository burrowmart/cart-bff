# Server
PORT=3000
NODE_ENV=development

# Cart storage — Redis only, no Mongo
# docker compose -f ../platform-infra/docker-compose.yml up -d redis
REDIS_URL=redis://localhost:6379
# Abandonment TTL for a cart hash, refreshed on every write. Default 7 days.
CART_TTL_SECONDS=604800

# Downstream services this BFF aggregates (REST, typed clients from @demo/contracts)
CATALOG_SERVICE_URL=http://localhost:3002
ORDER_SERVICE_URL=http://localhost:3003

# Auth
# AUTH_DISABLED=true skips identity extraction (tests/local dev).
# Signature verification lives in the Envoy PEP, not in the app.
AUTH_DISABLED=false

# Observability — OpenTelemetry
# Leave blank to use ConsoleSpanExporter (prints to stdout) for local dev
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=cart-bff
